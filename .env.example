# Server
PORT=3000
NODE_ENV=development

# Neon Postgres. Pooled string (host contains -pooler) for the app,
# direct string (same host without -pooler) for migrations.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Google OAuth client (Google Cloud Console > Google Auth Platform > Clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth. URL is the public origin of the app (the Vite dev server locally).
BETTER_AUTH_URL=http://localhost:5173
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
